# MediGuide AI - Environment Configuration
PORT=5000
NODE_ENV=development

# Database Connection (MongoDB URI)
# If MongoDB is not running locally, MediGuide AI automatically uses its resilient local storage fallback
MONGODB_URI=mongodb://localhost:27017/mediguide_db

# AI Diagnostic & Vision Provider Keys
# Leave blank to use MediGuide's Clinical Decision Support System & Rules Engine
GEMINI_API_KEY=
OPENAI_API_KEY=

# Geolocation & Maps (Optional - default uses interactive OpenStreetMap / Leaflet)
GOOGLE_MAPS_API_KEY=
